---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<header class="bg-ink text-card-soft">
		<div
			class="mx-auto flex w-full max-w-[76rem] items-baseline justify-between gap-4 px-5 py-3 sm:px-8"
		>
			<h1 class="font-display text-[0.9rem] font-semibold tracking-[0.02em]">Diario de Estudio</h1>
			<p class="font-display text-[0.7rem] tracking-[0.14em] uppercase text-wall/80">
				<time id="fecha-hoy">Hoy</time>
			</p>
		</div>
	</header>

	<main class="mx-auto w-full max-w-[76rem] px-5 pt-6 pb-16 sm:px-8 sm:pt-10">
		<div class="lg:grid lg:grid-cols-[minmax(0,34rem)_minmax(0,1fr)] lg:items-start lg:gap-10">
			<div class="min-w-0">
				<!-- Tarjeta de control: racha, últimos siete días y datos impresos. -->
				<section class="tarjeta px-5 py-5 sm:px-6 sm:py-6" aria-labelledby="titulo-racha">
					<h2 id="titulo-racha" class="sr-only">Tu racha</h2>

					<p class="racha-linea">
						<svg
							class="racha-fuego"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"
							></path>
						</svg>
						<span id="racha-cantidad" class="racha-numero">0</span>
						<span id="racha-unidad" class="racha-unidad">días seguidos</span>
						<span id="sello" class="sello hidden" aria-hidden="true">FICHADO</span>
					</p>
					<p id="racha-nota" class="racha-nota">Empieza hoy tu racha.</p>

					<!-- Mini calendario: los días con sesión como perforaciones. -->
					<div class="mini-calendario">
						<div class="mini-calendario-mes">
							<button type="button" id="cal-prev" class="btn-mes" aria-label="Mes anterior">
								‹
							</button>
							<p id="cal-mes" class="mini-calendario-titulo" aria-live="polite">
								Mes año
							</p>
							<button type="button" id="cal-next" class="btn-mes" aria-label="Mes siguiente">
								›
							</button>
						</div>

						<div id="cal-semana" class="mini-calendario-semana" aria-hidden="true"></div>

						<div
							id="cal-grid"
							class="mini-calendario-grid"
							role="group"
							aria-label="Días del mes"
						></div>
					</div>

					<dl class="ficha-datos">
						<div>
							<dt class="rotulo">Récord</dt>
							<dd id="racha-record">—</dd>
						</div>
						<div>
							<dt class="rotulo">Esta semana</dt>
							<dd id="tiempo-semana">0 min</dd>
						</div>
					</dl>
				</section>

				<!-- Registro de una sesión. -->
				<section class="mt-8" aria-labelledby="titulo-form">
					<h2 id="titulo-form" class="font-display text-sm font-semibold">Añadir sesión</h2>

					<form id="form-sesion" class="mt-4" novalidate>
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label for="fecha" class="rotulo">Fecha</label>
								<input id="fecha" name="fecha" type="date" required class="campo mt-1.5" />
							</div>
							<div>
								<label for="minutos" class="rotulo">Minutos</label>
								<input
									id="minutos"
									name="minutos"
									type="number"
									required
									min="1"
									step="1"
									inputmode="numeric"
									placeholder="p. ej. 45"
									class="campo mt-1.5"
								/>
							</div>
						</div>

						<p class="fecha-eco"><time id="fecha-eco"></time></p>

						<div class="mt-3">
							<label for="tema" class="rotulo">Tema</label>
							<input
								id="tema"
								name="tema"
								type="text"
								required
								autocomplete="off"
								placeholder="Qué has estudiado"
								class="campo mt-1.5"
							/>
						</div>

						<p id="error" class="error mt-3" role="alert"></p>

						<button
							type="submit"
							class="mt-4 w-full rounded-[3px] bg-stamp px-5 py-3 font-display text-sm font-semibold text-card-soft transition-colors hover:bg-stamp-deep active:translate-y-px sm:w-auto"
						>
							Guardar sesión
						</button>
					</form>
				</section>
			</div>

			<!-- Registro de sesiones. -->
			<section class="mt-10 lg:mt-0" aria-labelledby="titulo-sesiones">
				<div class="flex items-baseline justify-between gap-3 border-b border-rule pb-2">
					<h2 id="titulo-sesiones" class="font-display text-sm font-semibold">Sesiones</h2>
					<p id="total-sesiones" class="font-display text-xs text-ink-soft tabular-nums">
						0 sesiones
					</p>
				</div>

				<ul id="lista-sesiones" class="hidden"></ul>
				<p id="lista-vacia" class="mt-4 text-sm leading-relaxed text-ink-soft">
					Aún no hay sesiones. Registra la primera arriba y abre la racha.
				</p>
			</section>
		</div>
</main>

	<!-- Anuncios para lectores de pantalla: solo cambian al guardar. -->
	<p id="anuncio" class="sr-only" role="status" aria-live="polite"></p>
</Layout>

<script>
	import {
		fechaLocal,
		fechaDeISO,
		esFechaISOValida,
		sumarDias,
		mesVecino,
		construirCeldas,
		etiquetasSemana,
	} from "../scripts/calendario.js";

	// Clave con la que guardamos las sesiones en el navegador.
	const CLAVE = "diario-estudio.sesiones.v1";

	const form = document.getElementById("form-sesion");
	const inputFecha = document.getElementById("fecha");
	const inputTema = document.getElementById("tema");
	const inputMinutos = document.getElementById("minutos");
	const cajaError = document.getElementById("error");
	const lista = document.getElementById("lista-sesiones");
	const listaVacia = document.getElementById("lista-vacia");
	const totalSesiones = document.getElementById("total-sesiones");
	const rachaCantidad = document.getElementById("racha-cantidad");
	const rachaUnidad = document.getElementById("racha-unidad");
	const rachaNota = document.getElementById("racha-nota");
	const rachaRecord = document.getElementById("racha-record");
	const tiempoSemana = document.getElementById("tiempo-semana");
	const sello = document.getElementById("sello");
	const anuncio = document.getElementById("anuncio");
	const fechaHoy = document.getElementById("fecha-hoy");
	const fechaEco = document.getElementById("fecha-eco");
	const calMes = document.getElementById("cal-mes");
	const calGrid = document.getElementById("cal-grid");
	const calSemana = document.getElementById("cal-semana");
	const btnCalPrev = document.getElementById("cal-prev");
	const btnCalNext = document.getElementById("cal-next");

	/** Lee las sesiones guardadas e ignora las entradas corruptas.
	 *  Así un `localStorage` editado a mano no rompe la lista ni el calendario. */
	function leerSesiones() {
		try {
			const guardado = localStorage.getItem(CLAVE);
			if (!guardado) return [];
			const sesiones = JSON.parse(guardado);
			if (!Array.isArray(sesiones)) return [];

			return sesiones.filter(
				(sesion) =>
					sesion !== null &&
					typeof sesion === "object" &&
					esFechaISOValida(sesion.date) &&
					typeof sesion.topic === "string" &&
					typeof sesion.minutes === "number" &&
					Number.isFinite(sesion.minutes),
			);
		} catch {
			return [];
		}
	}

	function guardarSesiones(sesiones) {
		try {
			localStorage.setItem(CLAVE, JSON.stringify(sesiones));
		} catch {
			// Si el navegador bloquea localStorage, la sesión no se guarda.
		}
	}

	/** Días consecutivos con al menos una sesión, contando desde hoy.
	 *  Si hoy aún no hay sesión pero ayer sí, la racha sigue viva. */
	function calcularRacha(sesiones) {
		const dias = new Set(sesiones.map((sesion) => sesion.date));
		const hoy = fechaLocal(new Date());
		const ayer = sumarDias(hoy, -1);

		let cursor = dias.has(hoy) ? hoy : dias.has(ayer) ? ayer : null;
		let racha = 0;

		while (cursor && dias.has(cursor)) {
			racha += 1;
			cursor = sumarDias(cursor, -1);
		}

		return racha;
	}

	/** Tirada consecutiva más larga de días con sesión (récord personal).
	 *  Se calcula desde las sesiones, así que no puede desincronizarse. */
	function calcularRecord(sesiones) {
		const hoy = fechaLocal(new Date());
		const dias = [
			...new Set(
				sesiones
					.map((sesion) => sesion.date)
					.filter((dia) => /^\d{4}-\d{2}-\d{2}$/.test(dia) && dia <= hoy),
			),
		].sort();

		let record = 0;
		let actual = 0;
		let anterior = null;

		for (const dia of dias) {
			actual = anterior && sumarDias(anterior, 1) === dia ? actual + 1 : 1;
			if (actual > record) record = actual;
			anterior = dia;
		}

		return record;
	}

	/** Lunes de la semana a la que pertenece una fecha "AAAA-MM-DD". */
	function inicioSemana(fechaISO) {
		const fecha = fechaDeISO(fechaISO);
		const offset = (fecha.getDay() + 6) % 7; // getDay(): 0 = domingo
		fecha.setDate(fecha.getDate() - offset);
		return fechaLocal(fecha);
	}

	/** Minutos estudiados en la semana actual, desde el lunes hasta hoy. */
	function minutosSemana(sesiones) {
		const hoy = fechaLocal(new Date());
		const inicio = inicioSemana(hoy);

		return sesiones
			.filter((sesion) => sesion.date >= inicio && sesion.date <= hoy)
			.reduce((total, sesion) => {
				const minutos = Number(sesion.minutes);
				return total + (Number.isInteger(minutos) && minutos > 0 ? minutos : 0);
			}, 0);
	}

	/** Convierte minutos a un texto corto: "2 h 30 min", "2 h", "45 min". */
	function formatearDuracion(minutos) {
		const horas = Math.floor(minutos / 60);
		const resto = minutos % 60;

		if (horas === 0) return `${resto} min`;
		if (resto === 0) return `${horas} h`;
		return `${horas} h ${resto} min`;
	}

	const formatoDia = new Intl.DateTimeFormat("es-ES", { day: "2-digit" });
	const formatoMes = new Intl.DateTimeFormat("es-ES", { month: "short" });
	const formatoCabecera = new Intl.DateTimeFormat("es-ES", {
		weekday: "short",
		day: "2-digit",
		month: "short",
	});
	const formatoFechaLarga = new Intl.DateTimeFormat("es-ES", {
		weekday: "long",
		day: "numeric",
		month: "long",
		year: "numeric",
	});
	const formatoMesYear = new Intl.DateTimeFormat("es-ES", {
		month: "long",
		year: "numeric",
	});

	/** Mes y año que muestra el calendario. Empieza en el mes actual. */
	let calFecha = fechaDeISO(fechaLocal(new Date()));

	/** Crea la fila de una sesión con createElement + textContent
	 *  para que el texto del usuario se muestre tal cual. */
	function crearFila(sesion) {
		const fecha = fechaDeISO(sesion.date);

		const fila = document.createElement("li");
		fila.className = "sesion";

		const columnaFecha = document.createElement("span");
		columnaFecha.className = "sesion-fecha";

		const diaConMes = document.createElement("strong");
		diaConMes.textContent = `${formatoDia.format(fecha)} ${formatoMes.format(fecha)}`;
		columnaFecha.append(diaConMes, String(fecha.getFullYear()));

		const tema = document.createElement("span");
		tema.className = "sesion-tema";
		tema.textContent = sesion.topic;

		const minutos = document.createElement("span");
		minutos.className = "sesion-minutos";
		minutos.textContent = `${sesion.minutes} min`;

		fila.append(columnaFecha, tema, minutos);
		return fila;
	}

	/** Pinta una sola vez la cabecera de días, siempre de lunes a domingo. */
	function pintarCabeceraCalendario() {
		calSemana.replaceChildren(
			...etiquetasSemana().map((texto) => {
				const etiqueta = document.createElement("span");
				etiqueta.className = "dia-semana";
				etiqueta.textContent = texto;
				return etiqueta;
			}),
		);
	}

	/** Pinta la rejilla del mes indicado en calFecha.
	 *  Los días con sesión se leen como perforación; hoy lleva el aro del sello;
	 *  los días futuros quedan desactivados y nunca cuentan como hechos.
	 *  Es solo visual: la fecha se elige en el formulario. */
	function pintarCalendario(sesiones) {
		const diasConSesion = new Set(
			sesiones
				.map((sesion) => sesion.date)
				.filter((fecha) => typeof fecha === "string"),
		);
		const hoy = fechaLocal(new Date());

		const anio = calFecha.getFullYear();
		const mes = calFecha.getMonth();
		const titulo = formatoMesYear.format(calFecha);

		calMes.textContent = titulo;
		calGrid.setAttribute("aria-label", `Días de ${titulo}`);

		const celdas = construirCeldas(anio, mes, hoy, diasConSesion).map((celda) => {
			if (celda.vacia) {
				const vacio = document.createElement("span");
				vacio.className = "dia dia--vacio";
				vacio.setAttribute("aria-hidden", "true");
				return vacio;
			}

			const fecha = fechaDeISO(celda.fechaISO);
			const nodo = document.createElement("span");
			nodo.className = "dia";
			if (celda.esHoy) {
				nodo.classList.add("dia--hoy");
				nodo.setAttribute("aria-current", "date");
			}
			if (celda.esFuturo) nodo.classList.add("dia--futuro");
			if (celda.hecho) nodo.classList.add("dia--hecho");

			// El número es decorativo: el texto oculto da la fecha completa.
			const numero = document.createElement("span");
			numero.className = "dia-numero";
			numero.setAttribute("aria-hidden", "true");
			numero.textContent = String(celda.dia);

			const estado = celda.esFuturo
				? "no disponible"
				: celda.hecho
					? "con sesión"
					: "sin sesión";
			const descripcion = document.createElement("span");
			descripcion.className = "sr-only";
			descripcion.textContent = `${formatoFechaLarga.format(fecha)}: ${estado}${
				celda.esHoy ? ", hoy" : ""
			}`;

			nodo.append(numero, descripcion);
			return nodo;
		});

		calGrid.replaceChildren(...celdas);
	}

	/** Repinta la tarjeta, la lista y el calendario. Devuelve la racha. */
	function pintar() {
		const sesiones = leerSesiones().sort(
			(a, b) => b.date.localeCompare(a.date) || b.creado - a.creado,
		);

		// Racha
		const racha = calcularRacha(sesiones);
		rachaCantidad.textContent = String(racha);
		rachaUnidad.textContent = racha === 1 ? "día seguido" : "días seguidos";
		rachaNota.textContent =
			racha === 0 ? "Empieza hoy tu racha." : "La racha sigue viva hasta que acabe el día.";

		// Récord y semana
		const record = calcularRecord(sesiones);
		rachaRecord.textContent = record === 0 ? "—" : record === 1 ? "1 día" : `${record} días`;
		tiempoSemana.textContent = formatearDuracion(minutosSemana(sesiones));

		// Lista y calendario
		lista.replaceChildren(...sesiones.map(crearFila));
		lista.classList.toggle("hidden", sesiones.length === 0);
		listaVacia.classList.toggle("hidden", sesiones.length > 0);
		totalSesiones.textContent =
			sesiones.length === 1 ? "1 sesión" : `${sesiones.length} sesiones`;

		// Calendario (usa el mes que se tenga abierto).
		pintarCalendario(sesiones);

		return racha;
	}

	const campos = [inputFecha, inputTema, inputMinutos];

	/** Escribe la fecha elegida en español junto al control nativo,
	 *  para que el formato del navegador no deje la fecha ambigua. */
	function actualizarFechaEco() {
		const valor = inputFecha.value;

		if (!valor) {
			fechaEco.textContent = "Sin fecha";
			fechaEco.removeAttribute("datetime");
			return;
		}

		fechaEco.textContent = formatoFechaLarga.format(fechaDeISO(valor));
		fechaEco.setAttribute("datetime", valor);
	}

	/** Muestra un error y lo asocia al campo que lo provoca. */
	function mostrarError(mensaje, campo) {
		cajaError.textContent = mensaje;

		for (const otro of campos) {
			otro.removeAttribute("aria-invalid");
			otro.removeAttribute("aria-describedby");
		}

		if (campo) {
			campo.setAttribute("aria-invalid", "true");
			campo.setAttribute("aria-describedby", "error");
			campo.focus();
		}
	}

	/** Estampa el sello cada vez que se guarda una sesión. */
	function estamparSello() {
		sello.classList.remove("hidden");
		sello.classList.remove("sello--nuevo");
		void sello.offsetWidth; // reinicia la animación
		sello.classList.add("sello--nuevo");
	}

	form.addEventListener("submit", (evento) => {
		evento.preventDefault();

		const fecha = inputFecha.value;
		const tema = inputTema.value.trim();
		const minutos = Number(inputMinutos.value);
		const hoyISO = fechaLocal(new Date());

		if (!fecha) {
			mostrarError("Elige una fecha para la sesión.", inputFecha);
			return;
		}

		if (fecha > hoyISO) {
			mostrarError("No puedes registrar una sesión en el futuro.", inputFecha);
			return;
		}

		if (tema === "") {
			mostrarError("Escribe el tema que has estudiado.", inputTema);
			return;
		}

		if (!Number.isInteger(minutos) || minutos <= 0) {
			mostrarError("Los minutos tienen que ser un número entero mayor que 0.", inputMinutos);
			return;
		}

		const sesiones = leerSesiones();
		sesiones.push({
			id: crypto.randomUUID?.() ?? String(Date.now()),
			date: fecha,
			topic: tema,
			minutes: minutos,
			creado: Date.now(),
		});
		guardarSesiones(sesiones);

		// Salta al mes de la sesión guardada para que se vea la perforación.
		calFecha = fechaDeISO(fecha);

		form.reset();
		inputFecha.value = hoyISO;
		mostrarError("");
		actualizarFechaEco();
		const racha = pintar();
		estamparSello();
		anuncio.textContent = `Sesión guardada. Racha de ${racha} ${racha === 1 ? "día" : "días"}.`;
	});

	// Al escribir se limpia el error anterior y se actualiza el eco de la fecha.
	form.addEventListener("input", () => {
		mostrarError("");
		actualizarFechaEco();
	});

	// Cabecera con la fecha de hoy y primera pintada.
	const hoyISO = fechaLocal(new Date());
	fechaHoy.textContent = formatoCabecera.format(new Date());
	fechaHoy.setAttribute("datetime", hoyISO);
	inputFecha.max = hoyISO;
	inputFecha.value = hoyISO;
	actualizarFechaEco();
	pintarCabeceraCalendario();
	pintar();

	// Navegación del calendario.
	btnCalPrev.addEventListener("click", () => {
		calFecha = fechaDeISO(mesVecino(fechaLocal(calFecha), -1));
		pintarCalendario(leerSesiones());
	});

	btnCalNext.addEventListener("click", () => {
		calFecha = fechaDeISO(mesVecino(fechaLocal(calFecha), 1));
		pintarCalendario(leerSesiones());
	});
</script>
